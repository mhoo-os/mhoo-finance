{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": "..",
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["./*.tsx", "./*.ts", "./*.d.ts"],
  "exclude": ["../src/__tests__/**", "../src/front-components/**"]
}
