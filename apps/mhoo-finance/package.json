{
  "name": "@mhoo/finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2",
    "twenty": "2.37.0"
  },
  "keywords": [
    "twenty-app"
  ],
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "twenty": "twenty",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint --fix -c .oxlintrc.json .",
    "fixtures:generate": "node --experimental-strip-types scripts/generate-fixture-pack.mjs",
    "typecheck": "twenty dev:build && tsgo --noEmit -p tsconfig.spec.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "benchmark:population": "node --experimental-strip-types scripts/generate-benchmark-population.mjs",
    "fixtures:validate-ingestion": "node --experimental-strip-types scripts/validate-ingestion-fixtures.mjs",
    "preview:question": "node scripts/preview-question-prototype.mjs",
    "preview:reconciliation": "node scripts/preview-reconciliation-hero.mjs",
    "standalone:build": "vite build --config standalone-web/vite.config.ts",
    "standalone:typecheck": "tsgo --noEmit -p standalone-web/tsconfig.json"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260116.1",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "monaco-editor": "0.52.2",
    "oxlint": "^0.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "twenty-client-sdk": "2.37.0",
    "twenty-sdk": "2.37.0",
    "twenty-ui": "^1.0.0-alpha.1",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.0.0"
  }
}
